generator client {
  provider = "prisma-client-js"
}

// Default: SQLite for a local demo (`DATABASE_URL="file:./dev.db"`).
// Postgres: set provider = "postgresql" and point DATABASE_URL at your server.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Site {
  id        String   @id @default(cuid())
  url       String   @unique
  host      String
  createdAt DateTime @default(now())
  scans     Scan[]
}

model Scan {
  id                  String           @id @default(cuid())
  siteId              String
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status              String           @default("queued") // queued | running | completed | incomplete | failed
  requestedUrlsJson   String
  startedAt           DateTime         @default(now())
  finishedAt          DateTime?
  checkoutRendered    Boolean          @default(false)
  pagesReached        Int              @default(0)
  coverageWarning     Boolean          @default(false)
  priorScanDate       DateTime?
  priorPagesReached   Int?
  newIssueCount       Int              @default(0)
  clearedIssueCount   Int              @default(0)
  errorMessage        String?
  softError           Boolean          @default(false)
  uncheckedJson       String           @default("[]")
  isShopify           Boolean          @default(false)
  pages               Page[]
  issues              Issue[]
  statement           StatementDraft?

  @@index([siteId, startedAt])
}

model Page {
  id         String    @id @default(cuid())
  scanId     String
  scan       Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url        String
  pathname   String
  pathKind   String    // home | plp | pdp | cart | checkout | other
  status     String    @default("pending") // pending | reached | failed
  failReason String?
  title      String?
  scannedAt  DateTime?
  issues     Issue[]

  @@index([scanId, status])
}

model Issue {
  id          String @id @default(cuid())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  pageId      String
  page        Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  stableId    String
  ruleId      String
  title       String
  description String
  helpUrl     String
  severity    String // critical | serious | moderate | minor
  selector    String
  htmlSnippet String
  rankScore   Int

  @@index([scanId, stableId])
  @@index([scanId, rankScore])
}

model StatementDraft {
  id        String   @id @default(cuid())
  scanId    String   @unique
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

# SQLite (default, good for local demo). Path is relative to prisma/.
DATABASE_URL="file:./dev.db"

# Docker / Railway / Render image default (absolute path). Mount a volume at
# /data to keep the file. Do not commit a real hosted URL.
# DATABASE_URL="file:/data/recheck.db"

# Postgres (optional). Also change prisma/schema.prisma:
#   provider = "postgresql"
# then rebuild the image (the client is generated at build time).
# DATABASE_URL="postgresql://recheck:recheck@localhost:5432/recheck"

# Optional: override Chromium path if Playwright browsers are installed elsewhere.
# The Docker image sets this to /ms-playwright.
# PLAYWRIGHT_BROWSERS_PATH=

# next start reads PORT from the environment (default 3000). Railway and Render set it.
# PORT=3000
